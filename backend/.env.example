# ChartSafe AI analysis configuration (copy to backend/.env — gitignored).
# The key is read only by the local backend and is never sent to browsers.

# NVIDIA NIM (verified working 2026-10 with a build.nvidia.com nvapi key):
# CHARTSAFE_AI_KEY=nvapi-xxxxxxxxxxxxxxxx
# CHARTSAFE_AI_BASE=https://integrate.api.nvidia.com/v1
# Models are tried in order: the omni model answers fastest when it has
# capacity; the llama vision model is the reliable fallback.
# CHARTSAFE_AI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,meta/llama-3.2-11b-vision-instruct

# OpenRouter serving NVIDIA's vision model on the free tier (also verified):
# CHARTSAFE_AI_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
# CHARTSAFE_AI_BASE=https://openrouter.ai/api/v1
# CHARTSAFE_AI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Concept-image generation ("nano banana"). The default provider is Google's
# image model via Vertex AI, authenticated with the machine's Google
# application-default credentials — the same ADC login the team's working
# script uses. No key is needed when `gcloud auth application-default login`
# has been run on this machine. Optional overrides:
# CHARTSAFE_IMAGE_MODEL=gemini-3.1-flash-image
# CHARTSAFE_IMAGE_PROJECT=banana-bread-db
# CHARTSAFE_IMAGE_LOCATION=us-central1
# CHARTSAFE_IMAGE_CREDENTIALS=/path/to/application_default_credentials.json
# CHARTSAFE_IMAGE_TOKEN=<pre-provisioned access token>

# Fallback provider: NVIDIA Cosmos (needs deployment credentials — regular
# build.nvidia.com keys are NOT entitled, verified 2026-10).
# CHARTSAFE_COSMOS_KEY=<deployment access key>
# CHARTSAFE_COSMOS_URL=https://ai.api.nvidia.com/v1/cosmos/nvidia/cosmos3-nano
